// MyPaint.rc - Resource script for MyPaint application
#include "resource.h"
#include <windows.h>
#include <commctrl.h>

// Application icon
IDI_APPICON ICON "MyPaint.ico"

// Main menu
IDR_MENU_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",            ID_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",        ID_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",           ID_FILE_SAVE
        MENUITEM "Save &As...",             ID_FILE_SAVEAS
        MENUITEM "Sa&ve Options...",        ID_FILE_SAVE_OPTIONS
        MENUITEM "&Print...\tCtrl+P",       ID_FILE_PRINT
        MENUITEM "&Delete",                 ID_FILE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+F4",           ID_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",           ID_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y",           ID_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",            ID_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",           ID_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",          ID_EDIT_PASTE
        MENUITEM SEPARATOR
        MENUITEM "Select &All\tCtrl+A",     ID_EDIT_SELECT_ALL
    END
    POPUP "&Image"
    BEGIN
        MENUITEM "Rotate &Right 90°",       ID_IMAGE_ROTATE_RIGHT
        MENUITEM "Rotate &Left 90°",        ID_IMAGE_ROTATE_LEFT
        MENUITEM "Flip &Horizontal",        ID_IMAGE_FLIP_H
        MENUITEM "Flip &Vertical",          ID_IMAGE_FLIP_V
        MENUITEM SEPARATOR
        MENUITEM "&Crop to Selection\tCtrl+Shift+X", ID_IMAGE_CROP
        MENUITEM "&Resize Image...",        ID_IMAGE_RESIZE
    END
END

// Accelerator table
IDR_ACCELERATOR ACCELERATORS
BEGIN
    "N",    ID_FILE_NEW,        VIRTKEY, CONTROL
    "O",    ID_FILE_OPEN,       VIRTKEY, CONTROL
    "S",    ID_FILE_SAVE,       VIRTKEY, CONTROL
    "P",    ID_FILE_PRINT,      VIRTKEY, CONTROL
    "Z",    ID_EDIT_UNDO,       VIRTKEY, CONTROL
    "Y",    ID_EDIT_REDO,       VIRTKEY, CONTROL
    "X",    ID_EDIT_CUT,        VIRTKEY, CONTROL
    "C",    ID_EDIT_COPY,       VIRTKEY, CONTROL
    "V",    ID_EDIT_PASTE,      VIRTKEY, CONTROL
    "A",    ID_EDIT_SELECT_ALL, VIRTKEY, CONTROL
    "X",    ID_IMAGE_CROP,      VIRTKEY, CONTROL, SHIFT
    VK_F11, ID_VIEW_DARKMODE,   VIRTKEY
    // Zoom: Ctrl+= / Ctrl+- (main keys 0xBB / 0xBD, also the numpad), Ctrl+0 fit, Ctrl+1 100%
    0xBB,   ID_ZOOM_IN,         VIRTKEY, CONTROL
    0xBB,   ID_ZOOM_IN,         VIRTKEY, CONTROL, SHIFT
    VK_ADD, ID_ZOOM_IN,         VIRTKEY, CONTROL
    0xBD,   ID_ZOOM_OUT,        VIRTKEY, CONTROL
    VK_SUBTRACT, ID_ZOOM_OUT,   VIRTKEY, CONTROL
    "0",    ID_ZOOM_FIT_WINDOW, VIRTKEY, CONTROL
    VK_NUMPAD0, ID_ZOOM_FIT_WINDOW, VIRTKEY, CONTROL
    "1",    ID_ZOOM_ACTUAL,     VIRTKEY, CONTROL
    VK_NUMPAD1, ID_ZOOM_ACTUAL, VIRTKEY, CONTROL
END

// Text input dialog
IDD_TEXT_INPUT DIALOGEX 0, 0, 220, 75
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Enter Text"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Text to draw:", IDC_STATIC, 7, 7, 60, 9
    EDITTEXT        IDC_TEXT_EDIT, 7, 18, 206, 14, ES_AUTOHSCROLL
    LTEXT           "Font size (pt):", IDC_STATIC, 7, 40, 60, 9
    EDITTEXT        IDC_TEXT_SIZE, 70, 38, 30, 14, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "OK", IDOK, 110, 55, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 55, 50, 14
END

// Resize Image dialog
IDD_RESIZE_CANVAS DIALOGEX 0, 0, 210, 118
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Resize Image"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Width:",  IDC_STATIC,       7,  10, 38,  9
    EDITTEXT        IDC_RESIZE_W,                48,  8, 50, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px",      IDC_STATIC,      100, 10, 12,  9
    EDITTEXT        IDC_RESIZE_W_PCT,           114,  8, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "%",       IDC_STATIC,      156, 10,  8,  9

    LTEXT           "Height:", IDC_STATIC,        7, 28, 38,  9
    EDITTEXT        IDC_RESIZE_H,                48, 26, 50, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "px",      IDC_STATIC,      100, 28, 12,  9
    EDITTEXT        IDC_RESIZE_H_PCT,           114, 26, 40, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "%",       IDC_STATIC,      156, 28,  8,  9

    AUTOCHECKBOX    "Maintain aspect ratio",      IDC_RESIZE_LOCK_ASPECT,  7, 48, 130, 10
    AUTOCHECKBOX    "Canvas only (no image)",    IDC_RESIZE_CANVAS_ONLY,  7, 63, 130, 10

    DEFPUSHBUTTON   "OK",     IDOK,     35, 96, 60, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 110, 96, 60, 14
END

// File > Save Options: one page per format, chosen with the tab buttons.
// The JPEG and WebP pages share the quality controls; the frame around the
// page (7,22 - 243,108) is drawn in WM_PAINT.
IDD_SAVE_OPTIONS DIALOGEX 0, 0, 250, 136
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Save Options"
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON      "JPEG", IDC_SAVEOPT_TAB_JPEG,   7, 7, 50, 15, BS_OWNERDRAW
    PUSHBUTTON      "PNG",  IDC_SAVEOPT_TAB_PNG,   58, 7, 50, 15, BS_OWNERDRAW
    PUSHBUTTON      "WebP", IDC_SAVEOPT_TAB_WEBP, 109, 7, 50, 15, BS_OWNERDRAW

    LTEXT           "Quality:", IDC_SAVEOPT_QLABEL, 16, 33, 32, 9
    CONTROL         "", IDC_SAVEOPT_SLIDER, "msctls_trackbar32", TBS_HORZ | TBS_NOTICKS | WS_TABSTOP, 48, 29, 152, 16
    EDITTEXT        IDC_SAVEOPT_QUALITY, 204, 30, 30, 14, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Higher quality keeps more detail but gives a larger file. 100 is the best quality.", IDC_SAVEOPT_HINT, 16, 52, 222, 18
    AUTOCHECKBOX    "Lossless (exact colours, larger file)", IDC_SAVEOPT_LOSSLESS, 16, 52, 222, 10
    AUTOCHECKBOX    "Keep transparency", IDC_SAVEOPT_WEBP_ALPHA, 16, 66, 222, 10

    AUTORADIOBUTTON "Full colour", IDC_SAVEOPT_PNG_FULL, 16, 30, 222, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "256 colours (much smaller; good for screenshots and graphics)", IDC_SAVEOPT_PNG_256, 16, 43, 222, 10
    AUTOCHECKBOX    "Keep transparency", IDC_SAVEOPT_PNG_ALPHA, 16, 58, 222, 10, WS_GROUP | WS_TABSTOP
    LTEXT           "PNG is lossless: the picture is saved exactly. Images with no transparent areas are saved without a transparency layer, which is smaller.", IDC_SAVEOPT_PNG_HINT, 16, 71, 222, 18

    LTEXT           "Estimated size for this image:", IDC_SAVEOPT_SIZE, 16, 94, 222, 9

    PUSHBUTTON      "Restore defaults", IDC_SAVEOPT_DEFAULTS, 7, 115, 68, 14
    DEFPUSHBUTTON   "OK", IDOK, 137, 115, 52, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 191, 115, 52, 14
END

// Help / About dialog
IDD_ABOUT DIALOGEX 0, 0, 340, 295
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "MyPaint Help"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT        IDC_HELP_TEXT, 7, 7, 326, 268,
                    ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | ES_NOHIDESEL |
                    WS_VSCROLL | WS_BORDER | NOT WS_TABSTOP
    DEFPUSHBUTTON   "OK", IDOK, 145, 279, 50, 14
END

// String table
STRINGTABLE
BEGIN
    IDS_APP_TITLE       "MyPaint"
    IDS_UNTITLED        "Untitled"
END
